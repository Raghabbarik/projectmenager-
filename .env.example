# ==============================================================================
# My Journey — Environment Variables for Local & Vercel Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Database & Auth Configuration
# ------------------------------------------------------------------------------
# Required for user authentication, team collaboration, and cloud database sync.
# Find these in your Supabase project dashboard under Project Settings > API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Next.js / Serverless compatibility fallbacks (Optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# ------------------------------------------------------------------------------
# 2. Centralized Redis Cache (Upstash Redis)
# ------------------------------------------------------------------------------
# Acts as a single high-speed shared cache eliminating redundant database queries.
# Get a free database at https://upstash.com or via the Vercel Marketplace.
VITE_REDIS_REST_URL="https://your-database.upstash.io"
VITE_REDIS_REST_TOKEN="your-upstash-rest-token"

# Serverless compatibility fallbacks (Optional)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Key (Optional)
# ------------------------------------------------------------------------------
# Used by the AI Assistant page for productivity summaries and queries.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. Hosted App URL (Optional)
# ------------------------------------------------------------------------------
# e.g., https://my-journey.vercel.app
APP_URL="https://my-journey.vercel.app"
